{
  "name": "paperdock-dsh-plugin",
  "version": "2.0.2",
  "private": true,
  "description": "PaperDock：原生右侧栏 PDF 阅读、翻译、标注与笔记",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs ../pdf-dock-plugin/tests/*.test.*",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.2-rc.1"
  },
  "devDependencies": {
    "playwright": "1.58.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
